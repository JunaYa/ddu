{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vue", "vitest", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    // Stylesheets are imported for their side effects.
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    // Fire-and-forget .then() callbacks that only update state are fine.
    "promise/always-return": "off",
    // `_`-prefixed names are intentionally unused (e.g. required callback params).
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ]
  },
  "overrides": [
    {
      "files": ["*.config.ts", "scripts/**"],
      "env": { "node": true }
    }
  ],
  "ignorePatterns": ["dist/**", "public/**", "src-tauri/**", "vendors/**"]
}
